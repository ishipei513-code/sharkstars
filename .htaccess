<IfModule mod_rewrite.c>
RewriteEngine On

# ── client/muku → muku.homes（独自ドメイン移行・301）──
# sharkstars.jp に来たアクセスだけ muku.homes へ転送する。
# muku.homes 自身（公開フォルダ = client/muku）では発火させず、リダイレクトループを防ぐ。
RewriteCond %{HTTP_HOST} ^(www\.)?sharkstars\.jp$ [NC]
RewriteRule ^client/muku/(.*)$ https://muku.homes/$1 [R=301,L]

# www → non-www（HTTPSに統一する前に正規化）
RewriteCond %{HTTP_HOST} ^www\.sharkstars\.jp$ [NC]
RewriteRule ^(.*)$ https://sharkstars.jp/$1 [R=301,L]

# HTTP → HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# HSTS（HTTPS-only であることを Google・ブラウザに強く伝える）
<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# ── 作業用ファイルの直リンク遮断 ──
# リポジトリ全体をサーバーにミラーしている運用のため、CSV・Markdown・スクリプト類が
# そのまま公開されてしまう。2026-10-24 に crm_template.csv（顧客の氏名・電話番号入り）が
# ブラウザから落とせる状態だったため追加。llms.txt / llms-full.txt は .txt なので対象外。
<FilesMatch "\.(csv|md|ps1|py|sh|bat|ini|log|psd|ai|xlsx?|docx?|pptx?|zip|bak)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ── 社内資料ディレクトリを丸ごと遮断 ──
# docs/（契約書・見積書・ヒアリング）、scripts/（作業スクリプト49本）、releases/（納品zip）は
# Web公開する必要がない。将来 docs/clients/ を同期してしまっても漏れないよう、拡張子ではなく
# ディレクトリ単位で止める。サイトからこれらを参照しているリンクは無い。
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(docs|scripts|releases)(/|$) - [F,L]
</IfModule>
