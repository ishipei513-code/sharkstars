          <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px">
            <div style="width:48px;height:48px;border-radius:50%;background:var(--c-cream);display:flex;align-items:center;justify-content:center;font-family:var(--f-serif);font-size:1.1rem;color:var(--c-gold);font-weight:600">Y</div>
