---
// 墨の滴り — GLSL で fbm 歪みを使った拡散表現
interface Props {
  size?: string; // CSS size (e.g., "360px" or "28vw")
  seed?: number;
  intensity?: number; // 0..1
}
const { size = "360px", seed = 7, intensity = 1 } = Astro.props;
const id = `ink-${Math.round(Math.random() * 1e9)}`;
---

<div class="ink-wrap" style={`--ink-size: ${size};`}>
  <canvas id={id} class="ink-canvas" data-seed={seed} data-intensity={intensity} aria-hidden="true"
  ></canvas>
</div>

<script>
  import * as THREE from "three";

  const init = (canvas: HTMLCanvasElement) => {
    const seed = Number(canvas.dataset.seed || 0);
    const intensity = Number(canvas.dataset.intensity || 1);

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    const scene = new THREE.Scene();
    const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);

    const vertex = /* glsl */ `
      varying vec2 vUv;
      void main() { vUv = uv; gl_Position = vec4(position,1.0); }
    `;
    const fragment = /* glsl */ `
      precision highp float;
      varying vec2 vUv;
      uniform float uTime;
      uniform float uSeed;
      uniform float uIntensity;
      uniform float uImpact;

      float hash(vec2 p){ return fract(sin(dot(p + uSeed, vec2(127.1,311.7)))*43758.5453); }
      float noise(vec2 p){
        vec2 i=floor(p), f=fract(p);
        vec2 u=f*f*(3.0-2.0*f);
        return mix(
          mix(hash(i), hash(i+vec2(1,0)), u.x),
          mix(hash(i+vec2(0,1)), hash(i+vec2(1,1)), u.x), u.y);
      }
      float fbm(vec2 p){
        float v=0.0, a=0.5;
        mat2 r = mat2(0.8,-0.6,0.6,0.8);
        for(int i=0;i<6;i++){ v+=a*noise(p); p=r*p*2.02; a*=0.5; }
        return v;
      }

      void main() {
        vec2 uv = vUv - 0.5;

        // slow rotational drift
        float ang = uTime * 0.03;
        mat2 R = mat2(cos(ang), -sin(ang), sin(ang), cos(ang));
        vec2 rUv = R * uv;

        // warp field for tendrils
        vec2 w = vec2(
          fbm(rUv * 3.4 + uTime * 0.04),
          fbm(rUv * 3.4 - uTime * 0.05 + 13.0)
        ) - 0.5;
        vec2 p = rUv + w * (0.22 + uImpact * 0.1);
        float r = length(p);

        // ink density: expanding core + tendrils
        float baseSpread = 0.22 + uTime * 0.010 + uImpact * 0.08;
        float core = smoothstep(baseSpread, baseSpread*0.25, r);

        // filaments at outer edge
        float fil = fbm(p * 9.0 + uTime * 0.08);
        float edge = smoothstep(baseSpread*1.35, baseSpread*0.95, r);
        float tendril = edge * smoothstep(0.42, 0.72, fil);

        float density = clamp(core + tendril * 0.8, 0.0, 1.0);
        density *= uIntensity;

        // micro dots (ink specks escaped)
        float dots = smoothstep(0.92, 0.98, fbm(p*22.0 + uTime*0.02));
        float dotsMask = smoothstep(baseSpread*1.6, baseSpread*0.7, r);
        density = max(density, dots * dotsMask * 0.75);

        vec3 inkColor = vec3(0.022, 0.035, 0.045);
        // slight warm iris as ink bleeds in water
        inkColor += vec3(0.025, 0.015, 0.005) * (1.0 - density);

        gl_FragColor = vec4(inkColor, density * 0.95);
      }
    `;

    const material = new THREE.ShaderMaterial({
      vertexShader: vertex,
      fragmentShader: fragment,
      transparent: true,
      uniforms: {
        uTime: { value: 0 },
        uSeed: { value: seed },
        uIntensity: { value: intensity },
        uImpact: { value: 0 },
      },
    });

    // expose per-canvas material
    (canvas as any).__inkMaterial = material;

    const mesh = new THREE.Mesh(new THREE.PlaneGeometry(2, 2), material);
    scene.add(mesh);

    const resize = () => {
      const r = canvas.getBoundingClientRect();
      renderer.setSize(Math.max(r.width, 1), Math.max(r.height, 1), false);
    };
    resize();
    const ro = new ResizeObserver(resize);
    ro.observe(canvas);

    const t0 = performance.now();
    const loop = () => {
      material.uniforms.uTime.value = (performance.now() - t0) / 1000;
      // decay impact
      material.uniforms.uImpact.value *= 0.96;
      renderer.render(scene, camera);
      requestAnimationFrame(loop);
    };
    loop();
  };

  document.querySelectorAll<HTMLCanvasElement>("canvas.ink-canvas").forEach(init);
</script>

<style>
  .ink-wrap {
    width: var(--ink-size);
    height: var(--ink-size);
    position: relative;
    pointer-events: none;
  }
  .ink-canvas {
    width: 100%;
    height: 100%;
    display: block;
    mix-blend-mode: multiply;
    filter: drop-shadow(0 14px 28px rgba(0, 0, 0, 0.4));
  }
</style>
