---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  keywords?: string;
}

const baseUrl = import.meta.env.BASE_URL;

const {
  title = "NOCTURNE — Contemporary Ink Art Gallery | 福岡の現代墨アート・ギャラリー",
  description = "夜の水槽にただ一点、墨の絵が浮かぶ。福岡市のコンテンポラリー墨アート・ギャラリー NOCTURNE 公式サイト。常設展 / 企画展 / アーティスト / プログラム / 来館情報。",
  image = `${baseUrl}og.png`,
  canonical = Astro.url.href,
  keywords = "墨アート,現代美術,ギャラリー,福岡,コンテンポラリーアート,インクアート,夜の美術館,NOCTURNE,水墨,企画展",
} = Astro.props;

const siteName = "NOCTURNE";
const locale = "ja_JP";

const galleryJsonLd = {
  "@context": "https://schema.org",
  "@type": "ArtGallery",
  name: siteName,
  alternateName: "ノクターン",
  url: canonical,
  image: new URL(image, Astro.url).href,
  description,
  address: {
    "@type": "PostalAddress",
    addressCountry: "JP",
    addressRegion: "福岡県",
    addressLocality: "福岡市中央区",
    streetAddress: "警固 X-Y-Z",
    postalCode: "810-0023",
  },
  geo: { "@type": "GeoCoordinates", latitude: 33.5863, longitude: 130.3934 },
  telephone: "+81-92-000-0000",
  email: "hello@nocturne.gallery",
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
      opens: "15:00",
      closes: "23:00",
    },
  ],
  slogan: "The Gallery of Concrete Silence, After Dark.",
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL(baseUrl, Astro.url).href },
  ],
};

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteName,
  url: new URL(baseUrl, Astro.url).href,
  inLanguage: "ja-JP",
  description,
};

const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteName,
  url: canonical,
  logo: new URL(`${baseUrl}favicon.svg`, Astro.url).href,
  contactPoint: [
    {
      "@type": "ContactPoint",
      contactType: "reservations",
      email: "hello@nocturne.gallery",
      availableLanguage: ["ja", "en"],
    },
  ],
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content="#050C10" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={siteName} />
    <meta
      name="robots"
      content="index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1"
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.url).href} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,300;0,400;1,300;1,400&family=Noto+Serif+JP:wght@200;300;400&family=IBM+Plex+Mono:wght@300;400&display=swap"
      rel="stylesheet"
    />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(galleryJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    <slot name="head" />
  </head>
  <body>
    <slot />

    <style is:global>
      @property --depth {
        syntax: "<number>";
        inherits: false;
        initial-value: 0;
      }
      @property --carve {
        syntax: "<number>";
        inherits: false;
        initial-value: 1;
      }

      :root {
        --ink: #050c10;
        --water: #1a5460;
        --water-deep: #081e24;
        --water-shallow: #2a7a86;
        --brass: #c4b890;
        --brass-deep: #8a7d5a;
        --paper: #e6dfc9;
        --hair: rgba(196, 184, 144, 0.22);
        --hair-bright: rgba(196, 184, 144, 0.45);
      }

      *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

      html { scroll-behavior: auto; -webkit-text-size-adjust: 100%; }

      body {
        background: var(--ink);
        color: var(--brass);
        font-family: "Cormorant", "Didot", "Noto Serif JP", serif;
        font-weight: 300;
        font-feature-settings: "palt", "liga", "kern";
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: geometricPrecision;
        overflow-x: hidden;
        min-height: 100vh;
      }

      .mono {
        font-family: "IBM Plex Mono", "Courier Prime", monospace;
        letter-spacing: 0.12em;
      }

      .jp {
        font-family: "Noto Serif JP", "Yu Mincho", serif;
        font-weight: 200;
      }

      .italic { font-style: italic; }

      ::selection { background: var(--brass); color: var(--ink); }

      a { color: inherit; text-decoration: none; }
      img, svg { display: block; max-width: 100%; }

      h1, h2, h3, h4 { font-weight: 300; line-height: 1; }

      .sr-only {
        position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
        overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
      }
    </style>
  </body>
</html>
