---
import Layout from "../layouts/Layout.astro";
import TankBackground from "../components/TankBackground.astro";
import InkDrop from "../components/InkDrop.astro";
import SuspendedArt from "../components/SuspendedArt.astro";
import BrassPlate from "../components/BrassPlate.astro";

const exhibitionJsonLd = {
  "@context": "https://schema.org",
  "@type": "ExhibitionEvent",
  name: "BLUE HOUR — The Ink That Remembers Water",
  description:
    "NOCTURNE 開廊記念展。夜の水槽に墨が滴り、記憶のように拡散する、5 名の現代墨作家による連作展示。",
  startDate: "2026-04-15",
  endDate: "2026-08-31",
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  location: {
    "@type": "Place",
    name: "NOCTURNE",
    address: {
      "@type": "PostalAddress",
      addressCountry: "JP",
      addressRegion: "福岡県",
      addressLocality: "福岡市中央区",
      streetAddress: "警固 X-Y-Z",
      postalCode: "810-0023",
    },
  },
  organizer: { "@type": "Organization", name: "NOCTURNE" },
};

const artists = [
  { no: "01", name: "Yuu Nakamura", jp: "中村 有",     technique: "Sumi, gofun on washi",     born: "Kyoto / 1984" },
  { no: "02", name: "Sei Oda",      jp: "織田 星",     technique: "Graphite, ink on linen",    born: "Fukuoka / 1991" },
  { no: "03", name: "Lena Wexler",  jp: "レナ・ウェクスラー", technique: "Pigment ink, silver leaf", born: "Vienna / 1977" },
  { no: "04", name: "Ren Hoshino",  jp: "星野 蓮",     technique: "Ink, mercury leaf on paper",born: "Tokyo / 1989" },
  { no: "05", name: "Marek Varga",  jp: "マレク・ヴァルガ", technique: "Lampblack, beeswax",     born: "Budapest / 1978" },
];

const program = [
  { date: "2026-05-10", time: "19:00", title: "Artist Talk — 中村 有",    kind: "TALK",      venue: "Tank Room" },
  { date: "2026-06-07", time: "20:00", title: "Ink & Silence",            kind: "PERF",      venue: "Tank Room" },
  { date: "2026-07-12", time: "15:00", title: "Washi Workshop",           kind: "WORKSHOP",  venue: "B1 Atelier" },
  { date: "2026-08-02", time: "19:30", title: "Closing Reading",          kind: "TALK",      venue: "Tank Room" },
];

const news = [
  { date: "2026-04-02", title: "開廊のお知らせ / NOCTURNE opens April 15.", tag: "ANNOUNCE" },
  { date: "2026-03-20", title: "BLUE HOUR 展 — 参加アーティスト発表。",      tag: "EXHIBITION" },
  { date: "2026-03-04", title: "夜間開廊について (15:00 — 23:00)。",          tag: "NOTICE" },
  { date: "2026-02-28", title: "メンバーシップ募集開始。",                    tag: "MEMBERSHIP" },
];
---

<Layout>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(exhibitionJsonLd)} slot="head" />

  <TankBackground />

  <header class="fixed-hdr">
    <p class="hdr-brand mono">NOCTURNE</p>
    <nav class="hdr-nav mono" aria-label="primary">
      <a href="#concept">§01</a>
      <a href="#exhibition">§02</a>
      <a href="#artists">§03</a>
      <a href="#program">§04</a>
      <a href="#news">§05</a>
      <a href="#visit">§06</a>
      <a href="#contact">§07</a>
    </nav>
    <p class="hdr-time mono">FUKUOKA · MMXXVI · NIGHT</p>
  </header>

  <main class="stage">
    <!-- =============== HERO =============== -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="water-line" aria-hidden="true">
        <span class="waterline"></span>
        <span class="waterline waterline-2"></span>
      </div>

      <div class="hero-art">
        <SuspendedArt
          no="001"
          title="Blue Hour, I."
          artist="Yuu Nakamura"
          year="2026"
          medium="Sumi on washi, H 1,380 × W 980 mm"
          size="220px"
        />
      </div>

      <div class="hero-ink hero-ink-a" aria-hidden="true">
        <InkDrop size="320px" seed={11} />
      </div>
      <div class="hero-ink hero-ink-b" aria-hidden="true">
        <InkDrop size="160px" seed={3} intensity={0.7} />
      </div>

      <h1 id="hero-title" class="hero-title" aria-label="NOCTURNE — Contemporary Ink Art Gallery">
        <span class="line"><span class="line-inner">Nocturne</span></span>
        <span class="line"><span class="line-inner line-italic">&nbsp;after&nbsp;dark</span></span>
      </h1>

      <aside class="hero-meta">
        <p class="meta-sub italic">— A Gallery of Ink, Water, and Silence.</p>
        <p class="jp meta-jp">
          夜 15 時から 23 時まで、墨と水の気配だけが息をしている。
        </p>
      </aside>

      <div class="hero-plate">
        <BrassPlate
          no="001"
          label="BLUE HOUR"
          sub="2026.04.15 — 08.31"
          size="lg"
        />
      </div>

      <div class="hero-scroll mono" aria-hidden="true">
        <span>DESCEND</span>
        <span class="arrow">↓</span>
      </div>
    </section>

    <!-- =============== § 01 CONCEPT =============== -->
    <section class="concept" id="concept" aria-labelledby="concept-title">
      <div class="sec-label mono">§ 01 &nbsp;·&nbsp; CONCEPT</div>

      <div class="concept-grid">
        <div class="concept-ink" aria-hidden="true">
          <InkDrop size="380px" seed={23} />
        </div>
        <div class="concept-text">
          <h2 id="concept-title" class="sec-title">
            <span class="italic">What</span>&nbsp;the ink<br />
            <span class="jp">は</span>&nbsp;<span class="italic">remembers.</span>
          </h2>
          <p class="body jp">
            NOCTURNE は、夜にしか開かない現代墨アートのギャラリーです。
            福岡・警固の地下 2 階、光を絶った展示室にひとつの水槽だけを据え、
            その中にただ一点、墨絵を沈めます。
          </p>
          <p class="body jp">
            墨は、水の上でしか本当のかたちを見せません。
            紙は墨の軌跡を <strong>記憶</strong> として残し、
            水はそれを <strong>忘却</strong> として拡散します。
            私たちは、作品と鑑賞者のあいだに、この忘却のための時間を置いています。
          </p>
          <p class="body jp">
            開廊は夜 15 時から 23 時まで。
            都市が静まる時間に合わせ、ひとり、あるいはふたりで訪れてください。
          </p>
        </div>
      </div>
    </section>

    <!-- =============== § 02 EXHIBITION =============== -->
    <section class="exhibition" id="exhibition" aria-labelledby="exh-title">
      <div class="sec-label mono">§ 02 &nbsp;·&nbsp; CURRENT EXHIBITION</div>

      <article class="exh" itemscope itemtype="https://schema.org/ExhibitionEvent">
        <h2 id="exh-title" class="exh-title" itemprop="name">
          <span class="italic">Blue Hour</span><br />
          <span class="jp">—</span> <span>The Ink That Remembers Water</span>
        </h2>

        <p class="exh-lead jp" itemprop="description">
          夜の水槽に墨が滴り、記憶のように拡散する——
          5 名の現代墨作家による連作 27 点の初公開展示。
          中村 有、織田 星、レナ・ウェクスラー、星野 蓮、マレク・ヴァルガ。
        </p>

        <dl class="exh-dl mono">
          <div>
            <dt>DATES</dt>
            <dd>
              <time datetime="2026-04-15" itemprop="startDate">15.04.2026</time>
              <span class="m-dash">—</span>
              <time datetime="2026-08-31" itemprop="endDate">31.08.2026</time>
            </dd>
          </div>
          <div>
            <dt>HOURS</dt>
            <dd>WED — SUN　15:00 — 23:00</dd>
          </div>
          <div>
            <dt>ADMISSION</dt>
            <dd>¥ 1,800 / Student ¥ 1,200 / Member FREE</dd>
          </div>
          <div>
            <dt>CURATOR</dt>
            <dd>Aoi Makihara <span class="m-dot">·</span> 牧原 蒼</dd>
          </div>
        </dl>
      </article>
    </section>

    <!-- =============== § 03 ARTISTS =============== -->
    <section class="artists" id="artists" aria-labelledby="artists-title">
      <div class="sec-label mono">§ 03 &nbsp;·&nbsp; ARTISTS</div>
      <h2 id="artists-title" class="sec-title">
        <span class="italic">Five</span> <span class="jp">の</span> <span class="italic">hands in water</span>
      </h2>

      <ul class="artist-list">
        {
          artists.map((a) => (
            <li class="artist-row">
              <span class="artist-filament" aria-hidden="true"></span>
              <div class="artist-tag">
                <p class="artist-no mono">№ {a.no}</p>
                <p class="artist-name italic">{a.name}</p>
                <p class="artist-jp jp">{a.jp}</p>
              </div>
              <div class="artist-meta mono">
                <span>{a.technique}</span>
                <span class="m-dash">—</span>
                <span>{a.born}</span>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- =============== § 04 PROGRAM =============== -->
    <section class="program" id="program" aria-labelledby="program-title">
      <div class="sec-label mono">§ 04 &nbsp;·&nbsp; PROGRAM</div>
      <h2 id="program-title" class="sec-title">
        <span class="italic">After-hours</span> <span class="jp">の</span> <span class="italic">events</span>
      </h2>

      <ol class="program-list">
        {
          program.map((e) => (
            <li class="program-row" itemscope itemtype="https://schema.org/Event">
              <div class="pr-date mono">
                <time datetime={e.date} itemprop="startDate">{e.date.replace(/-/g, ".")}</time>
                <span class="pr-time">{e.time}</span>
              </div>
              <div class="pr-body">
                <p class="pr-kind mono">{e.kind}</p>
                <h3 class="pr-title italic" itemprop="name">{e.title}</h3>
                <p class="pr-venue mono">
                  @ <span itemprop="location">{e.venue}</span>
                </p>
              </div>
              <a class="pr-cta mono" href="#contact">RSVP ↗</a>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- =============== § 05 NEWS =============== -->
    <section class="news" id="news" aria-labelledby="news-title">
      <div class="sec-label mono">§ 05 &nbsp;·&nbsp; NEWS</div>
      <h2 id="news-title" class="sec-title">
        <span class="italic">Ripples</span>
      </h2>
      <ul class="news-list">
        {
          news.map((n) => (
            <li class="news-row">
              <time class="news-date mono" datetime={n.date}>{n.date.replace(/-/g, ".")}</time>
              <span class="news-tag mono">{n.tag}</span>
              <p class="news-title jp">{n.title}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- =============== § 06 VISIT =============== -->
    <section class="visit" id="visit" aria-labelledby="visit-title">
      <div class="sec-label mono">§ 06 &nbsp;·&nbsp; VISIT</div>
      <h2 id="visit-title" class="visit-inscribed" aria-label="NOCTURNE, Fukuoka">
        <span>NOCTURNE</span>
      </h2>

      <div class="visit-grid">
        <address class="visit-addr jp">
          〒 810-0023<br />
          福岡県福岡市中央区<br />
          警固 X-Y-Z　NOCTURNE B2
        </address>
        <dl class="visit-dl mono">
          <div>
            <dt>HOURS</dt>
            <dd>15:00 — 23:00</dd>
          </div>
          <div>
            <dt>CLOSED</dt>
            <dd>MON &nbsp;·&nbsp; TUE</dd>
          </div>
          <div>
            <dt>ACCESS</dt>
            <dd>地下鉄「赤坂」駅 徒歩 6 分</dd>
          </div>
          <div>
            <dt>TEL</dt>
            <dd><a href="tel:+81920000000">+81 (0)92-000-0000</a></dd>
          </div>
        </dl>
        <div class="visit-plate">
          <BrassPlate no="EST." label="NOCTURNE" sub="MMXXVI · NIGHT · WATER · INK" size="md" />
        </div>
      </div>
    </section>

    <!-- =============== § 07 CONTACT =============== -->
    <section class="contact" id="contact" aria-labelledby="contact-title">
      <div class="sec-label mono">§ 07 &nbsp;·&nbsp; CONTACT</div>
      <h2 id="contact-title" class="sec-title">
        <span class="italic">Leave</span> <span class="jp">ひとしずく</span>
      </h2>
      <p class="contact-lead jp">
        ご予約・メディア取材・コレクター相談などは以下のフォームから。
        営業時間外の返信になる場合があります。
      </p>

      <form class="contact-form" action="#" method="post" novalidate>
        <div class="field">
          <label for="f-name" class="mono">NAME</label>
          <input id="f-name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="f-email" class="mono">EMAIL</label>
          <input id="f-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="f-purpose" class="mono">PURPOSE</label>
          <select id="f-purpose" name="purpose" required>
            <option value="visit">Reservation / 来館予約</option>
            <option value="press">Press / 取材</option>
            <option value="collect">Collector inquiry / 作品購入相談</option>
            <option value="membership">Membership / 入会</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div class="field field-full">
          <label for="f-msg" class="mono">MESSAGE</label>
          <textarea id="f-msg" name="message" rows="5" required></textarea>
        </div>
        <button class="submit mono" type="submit">
          <span>DROP INTO THE TANK</span>
          <span class="arrow">↘</span>
        </button>
      </form>
    </section>

    <footer class="foot">
      <p class="mono foot-brand">NOCTURNE &nbsp;©&nbsp; MMXXVI</p>
      <p class="mono foot-meta">Fukuoka, Japan &nbsp;·&nbsp; Est. 2026 &nbsp;·&nbsp; Night &amp; Ink</p>
      <ul class="foot-social mono" aria-label="social">
        <li><a href="#">INSTAGRAM ↗</a></li>
        <li><a href="#">X (TWITTER) ↗</a></li>
        <li><a href="#">VIMEO ↗</a></li>
      </ul>
    </footer>
  </main>
</Layout>

<script>
  import "../scripts/init.ts";
</script>

<style>
  .fixed-hdr {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px 34px;
    pointer-events: none;
    mix-blend-mode: screen;
  }
  .fixed-hdr > * { pointer-events: auto; }
  .hdr-brand { font-size: 11px; letter-spacing: 0.44em; color: var(--brass); }
  .hdr-nav {
    display: flex; gap: 22px;
    font-size: 10px; letter-spacing: 0.24em;
    color: var(--brass); opacity: 0.82;
  }
  .hdr-nav a { position: relative; padding: 4px 0; transition: color 0.3s ease; }
  .hdr-nav a:hover { color: var(--paper); }
  .hdr-time {
    font-size: 9px; letter-spacing: 0.28em;
    color: var(--brass); opacity: 0.7;
  }

  .stage { position: relative; z-index: 2; width: 100%; }

  /* ============ HERO ============ */
  .hero {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 760px;
  }

  .water-line {
    position: absolute;
    top: 18%;
    left: 0; right: 0;
    height: 2px;
    pointer-events: none;
    z-index: 2;
  }
  .waterline {
    position: absolute;
    left: 0; right: 0; top: 0;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent 0%,
      rgba(196, 184, 144, 0.2) 20%,
      rgba(240, 228, 190, 0.45) 50%,
      rgba(196, 184, 144, 0.2) 80%,
      transparent 100%
    );
  }
  .waterline-2 { top: 4px; opacity: 0.35; filter: blur(1.5px); }

  .hero-art {
    position: absolute;
    top: 26%;
    right: 22%;
    z-index: 4;
  }

  .hero-ink {
    position: absolute;
    z-index: 3;
    pointer-events: none;
  }
  .hero-ink-a { left: 6%; bottom: 4%; }
  .hero-ink-b { right: 9%; bottom: 16%; opacity: 0.72; }

  .hero-title {
    position: absolute;
    left: 6%; top: 38%;
    font-family: "Cormorant", "Didot", serif;
    font-weight: 300;
    font-size: clamp(72px, 11vw, 168px);
    line-height: 0.95;
    letter-spacing: -0.01em;
    color: var(--paper);
    z-index: 5;
    mix-blend-mode: screen;
  }
  .hero-title .line { display: block; overflow: hidden; }
  .hero-title .line-inner { display: inline-block; }
  .hero-title .line-italic {
    font-style: italic;
    font-size: 0.78em;
    opacity: 0.9;
    margin-left: 0.12em;
    color: var(--brass);
  }

  .hero-meta {
    position: absolute;
    left: 6%;
    top: calc(38% + clamp(72px, 11vw, 168px) * 0.95 + 30px);
    max-width: 460px;
    z-index: 5;
  }
  .meta-sub {
    font-family: "Cormorant", serif; font-style: italic;
    font-size: 14px; letter-spacing: 0.05em;
    color: var(--brass); opacity: 0.92;
    margin-bottom: 10px;
  }
  .meta-jp {
    font-size: 12px; line-height: 2; letter-spacing: 0.08em;
    color: var(--brass); opacity: 0.7;
  }

  .hero-plate { position: absolute; right: 7%; bottom: 8%; z-index: 4; }

  .hero-scroll {
    position: absolute;
    left: 50%; bottom: 28px;
    transform: translateX(-50%);
    display: flex; align-items: center; gap: 10px;
    font-size: 10px; letter-spacing: 0.32em;
    color: var(--brass); opacity: 0.75;
    z-index: 6;
  }
  .hero-scroll .arrow { animation: descend 2.4s ease-in-out infinite; font-size: 14px; }
  @keyframes descend {
    0%, 100% { transform: translateY(-1px); opacity: 0.55; }
    50%      { transform: translateY(6px);  opacity: 1; }
  }

  /* ============ Section common ============ */
  .sec-label {
    font-size: 10px; letter-spacing: 0.32em;
    color: var(--brass); opacity: 0.75;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--hair);
    max-width: 320px;
    margin-bottom: 48px;
  }
  .sec-title {
    font-family: "Cormorant", "Didot", serif;
    font-weight: 300;
    font-size: clamp(40px, 5vw, 76px);
    line-height: 1; letter-spacing: -0.01em;
    color: var(--paper);
    margin-bottom: 44px;
  }
  .body {
    font-family: "Noto Serif JP", serif;
    font-weight: 200; font-size: 15px;
    line-height: 2.3; letter-spacing: 0.05em;
    color: var(--brass);
    margin-bottom: 20px;
    max-width: 620px;
  }
  .body strong {
    font-weight: 400;
    color: var(--paper);
    border-bottom: 1px solid var(--hair-bright);
  }
  .m-dash { display: inline-block; margin: 0 8px; opacity: 0.5; }
  .m-dot  { display: inline-block; margin: 0 6px; opacity: 0.5; }

  /* ============ CONCEPT ============ */
  .concept { position: relative; padding: 22vh 8% 18vh; }
  .concept-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px;
    align-items: start;
  }
  .concept-ink {
    display: flex; justify-content: center;
    padding-top: 24px;
  }

  /* ============ EXHIBITION ============ */
  .exhibition { position: relative; padding: 18vh 8% 18vh; }
  .exh { max-width: 860px; }
  .exh-title {
    font-family: "Cormorant", "Didot", serif;
    font-weight: 300; font-size: clamp(44px, 6vw, 84px);
    line-height: 1.02; color: var(--paper);
    margin-bottom: 32px;
  }
  .exh-title .italic { font-style: italic; }
  .exh-lead {
    font-family: "Noto Serif JP", serif;
    font-weight: 200; font-size: 15px;
    line-height: 2.2; color: var(--brass);
    max-width: 580px;
    margin-bottom: 48px;
  }
  .exh-dl { font-size: 11px; letter-spacing: 0.2em; color: var(--brass); }
  .exh-dl > div {
    display: grid; grid-template-columns: 140px 1fr;
    padding: 14px 0;
    border-top: 1px solid var(--hair);
  }
  .exh-dl > div:last-child { border-bottom: 1px solid var(--hair); }
  .exh-dl dt { opacity: 0.6; }

  /* ============ ARTISTS ============ */
  .artists { position: relative; padding: 18vh 8% 18vh; }
  .artist-list {
    list-style: none;
    display: grid; gap: 76px;
    max-width: 1000px;
    margin-top: 40px;
  }
  .artist-row {
    position: relative;
    display: grid;
    grid-template-columns: 180px 1fr 1fr;
    gap: 48px;
    padding-top: 22px;
    align-items: start;
  }
  .artist-filament {
    position: absolute;
    top: -56px; left: 220px;
    width: 1px; height: 54px;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(196, 184, 144, 0.1) 15%,
      rgba(196, 184, 144, 0.55) 100%
    );
    transform-origin: top;
  }
  .artist-tag { padding-left: 18px; border-left: 1px solid var(--hair); }
  .artist-no { font-size: 9.5px; letter-spacing: 0.28em; opacity: 0.55; margin-bottom: 10px; }
  .artist-name {
    font-family: "Cormorant", serif; font-style: italic;
    font-size: clamp(22px, 2.4vw, 30px); font-weight: 300;
    color: var(--paper);
    margin-bottom: 4px;
  }
  .artist-jp {
    font-size: 12px; opacity: 0.72; letter-spacing: 0.1em;
    color: var(--brass);
  }
  .artist-meta {
    font-size: 10px; letter-spacing: 0.22em;
    line-height: 1.8; color: var(--brass); opacity: 0.75;
    padding-top: 4px;
    display: flex; flex-wrap: wrap; align-items: center; gap: 4px;
  }

